environment: development
http:
  port: 8086
jwt:
  access_token_ttl: "24h"
auth:
  bcrypt_cost: 12
runtime:
  data_dir: "./data"
  migration_db_storage_dir: "./data/migration-dbs"
  oauth_creds_dir: "./creds"
  log_address: "127.0.0.1:8081"
  # Use "debug" while diagnosing copy/traversal mismatches and worker failures.
  # Levels: trace, debug, info, warning, error, critical. DB stores all levels;
  # UDP terminal only emits at or above this threshold.
  log_level: "debug"
  enable_logging_terminal: false
  default_worker_count: 10
  default_max_retries: 3
  default_coordinator_lead: 4
services:
  local:
    - id: "local"
      name: "Local Filesystem"
      root_path: "/path/to/allowlisted/root"
providers:
  google_drive:
    enabled: true
    display_name: "Google Drive"
    service_id: google-drive
    scopes:
      - "https://www.googleapis.com/auth/drive"
  dropbox:
    enabled: true
    display_name: "Dropbox"
    service_id: dropbox
    scopes:
      - files.metadata.read
      - files.content.read
      - files.content.write
      - account_info.read
      - sharing.read
      - team_data.team_space
  onedrive:
    enabled: true
    display_name: "OneDrive"
    service_id: onedrive
    scopes:
      - Files.ReadWrite.All
      - offline_access
      - User.Read
  sharepoint:
    enabled: true
    display_name: "SharePoint"
    service_id: sharepoint
    scopes:
      - Sites.ReadWrite.All
      - Files.ReadWrite.All
      - offline_access
      - User.Read
  box:
    enabled: true
    display_name: "Box"
    service_id: box
    scopes:
      - root_readwrite
  sftp:
    enabled: true
    display_name: "SFTP"
    service_id: sftp
